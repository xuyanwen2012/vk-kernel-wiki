diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/topk_moe.comp b/ggml/src/ggml-vulkan/vulkan-shaders/topk_moe.comp
--- a/ggml/src/ggml-vulkan/vulkan-shaders/topk_moe.comp
