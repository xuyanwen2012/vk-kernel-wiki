diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/generic_head.glsl b/ggml/src/ggml-vulkan/vulkan-shaders/generic_head.glsl
--- a/ggml/src/ggml-vulkan/vulkan-shaders/generic_head.glsl
