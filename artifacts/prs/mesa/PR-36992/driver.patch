             case nir_cmat_call_op_reduce_2x2:
                progress |= lower_cmat_reduce_2x2_call(&b, call, &params);
                break;
+            case nir_cmat_call_op_per_element_op:
+               progress |= lower_cmat_per_element_op(&b, call, &params);
+               break;
             default:
                break;
             }
