+   adds[1] = nir_imul_imm(b, adds[1], desc.cols);
+   nir_def *add_vec = nir_vec(b, adds, 2);
+   def = nir_iadd(b, def, add_vec);
+   nir_def_replace(&intr->def, def);
+   return true;
