+      /* for each source split - reduce it by itself. */
+      int src_splits = 1;
+      if (src_split)
+         src_splits = src_split->num_col_splits * src_split->num_row_splits;
+      nir_deref_instr **temp_derefs = ralloc_array(NULL, nir_deref_instr *, src_splits);
