     match file {
-        RegFile::GPR => 6,
+        RegFile::GPR => gpr_latency,
         RegFile::UGPR => 12,
-        RegFile::Pred => 13,
+        RegFile::Pred => pred_latency,
         RegFile::UPred => 11,
         RegFile::Bar => 0, // Barriers have a HW scoreboard
         RegFile::Carry => 6,
