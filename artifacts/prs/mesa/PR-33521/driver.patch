-fn instr_latency(op: &Op, dst_idx: usize) -> u32 {
+fn instr_latency(sm: u8, op: &Op, dst_idx: usize) -> u32 {
     let file = match op.dsts_as_slice()[dst_idx] {
         Dst::None => return 0,
         Dst::SSA(vec) => vec.file().unwrap(),
         Dst::Reg(reg) => reg.file(),
