+                        let b_type = match flags.b_type() {
+                            GLSL_TYPE_UINT8 => IntType::U8,
+                            GLSL_TYPE_INT8 => IntType::I8,
+                            val => unreachable!("Invalid b_type: {val}"),
+                        };
+
+                        let mat_size = match flags.cmat_type() {
