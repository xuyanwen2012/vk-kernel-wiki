+            uint qb = ((low2 >> uint(8 + j * 2)) & 3u) | (((hi1 >> uint(4 + j)) & 1u) << 2);
+            uint qc = ((low2 >> uint(16 + j * 2)) & 3u) | (((hi1 >> uint(8 + j)) & 1u) << 2);
+            uint qd = ((low2 >> uint(24 + j * 2)) & 3u) | (((hi1 >> uint(12 + j)) & 1u) << 2);
+            w0[j] = float(qa) - 4.0;
+            w1[j] = float(qb) - 4.0;
+            w2v[j] = float(qc) - 4.0;
+            w3[j] = float(qd) - 4.0;
+        }
+        w0 = w0 * scale + vec4(offset);
+        w1 = w1 * scale + vec4(offset);
+        w2v = w2v * scale + vec4(offset);
+        w3 = w3 * scale + vec4(offset);
+
+        const uint xBase = idx << 2u;
+        sum += dot(w0, vec4(X4[xBase + 0u])) + dot(w1, vec4(X4[xBase + 1u])) +
+               dot(w2v, vec4(X4[xBase + 2u])) + dot(w3, vec4(X4[xBase + 3u]));
+    }
+
+    const uint tail = pc.K & 15u;
+    if (tail > 0u && lane == 0u) {
+        const uint idx = K16;
+        const uint pairBase = baseW + idx * 2u;
+        const uint low2 = Wp[pairBase + 0u];
+        const uint hi1 = Wp[pairBase + 1u];
+        const uint kBase = idx << 4u;
+        for (uint t = 0u; t < tail; ++t) {
+            const uint k = kBase + t;
+            const uint kb = k / safeBlockSize;
+            const uint metaBase = (baseM + kb) * 2u;
+            const float scale = float(Meta[metaBase + 0u]);
+            const float offset = float(Meta[metaBase + 1u]);
+            uint q = ((low2 >> (t * 2u)) & 3u) | (((hi1 >> t) & 1u) << 2);
+            const float w = float(q) - 4.0;
+            const uint xVec = k >> 2u;
+            const uint xLane = k & 3u;
+            sum += (w * scale + offset) * float(X4[xVec][int(xLane)]);
+        }
+    }
+
+    sdata[lane] = sum;
+    barrier();
+    for (uint s = LOCAL_SIZE / 2u; s > 0u; s >>= 1u) {
+        if (lane < s) sdata[lane] += sdata[lane + s];
+        barrier();
+    }
+    if (lane == 0u) {
+        float y = sdata[0] + float(Bias[row]);
+        if (ACTIVATION == 1u) y = max(y, 0.0);
+        else if (ACTIVATION == 2u) y = clamp(y, 0.0, 6.0);
+        Y[row] = FLOAT(y);
+    }
+}
diff --git a/source/backend/vulkan/buffer/execution/glsl/int2_weight_to_pack.comp b/source/backend/vulkan/buffer/execution/glsl/int2_weight_to_pack.comp
--- /dev/null
+++ b/source/backend/vulkan/buffer/execution/glsl/int2_weight_to_pack.comp
@@ -0,0 +1,74 @@
+// Dequantize int2 [padN, padK/16] uint32 packed weights into FLOAT4 B [K/4, N/32, 4, 8].
+// Each uint32 word holds 16 int2 unsigned values (signed = unsigned - 2).
+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer WeightBuffer {
+    uint SrcQ16[]; // [padN, UP_DIV(K, 16)], 16x int2 per uint32
+};
+
+layout(binding = 1) readonly buffer MetaBuffer {
+    FLOAT2 Meta[]; // [padN, KBlocks], each is [scale, offset]
+};
+
+layout(binding = 2) writeonly buffer DstBuffer {
+    FLOAT4 DstB4[]; // [K/4, N/32, 4, 8]
+};
+
+layout(push_constant) uniform PushConstants {
+    uint N;
+    uint K;
+    uint blockSize;
+    uint KBlocks;
+} pc;
+
+void main() {
+    const uint nVec = gl_GlobalInvocationID.x;
+    const uint k4 = gl_GlobalInvocationID.y;
+    const uint nVec4Count = pc.N >> 2u;
+    const uint K4 = pc.K >> 2u;
+    const uint nBlock32Count = pc.N >> 5u;
+    if (nVec >= nVec4Count || k4 >= K4) {
+        return;
+    }
+
+    const uint nBlock32 = nVec >> 3u;
+    const uint nVecIn32 = nVec & 7u;
+    const uint nBase = nVec << 2u;
+    const uint gkBase = k4 << 2u;
+
+    const uint wordsPerRow = (pc.K + 15u) >> 4u;
+    const uint wordOffset = gkBase >> 4u;       // gkBase / 16
+    const uint startBitInWord = (gkBase & 15u) * 2u; // 0, 8, 16, or 24
+
+    const uint row0 = nBase + 0u;
+    const uint row1 = nBase + 1u;
+    const uint row2 = nBase + 2u;
+    const uint row3 = nBase + 3u;
+
+    const uint w0 = SrcQ16[row0 * wordsPerRow + wordOffset];
+    const uint w1 = SrcQ16[row1 * wordsPerRow + wordOffset];
+    const uint w2 = SrcQ16[row2 * wordsPerRow + wordOffset];
+    const uint w3 = SrcQ16[row3 * wordsPerRow + wordOffset];
+
+    for (uint kIn4 = 0u; kIn4 < 4u; ++kIn4) {
+        const uint gk = gkBase + kIn4;
+        const uint kb = gk / max(pc.blockSize, 1u);
+        const FLOAT2 m0 = Meta[row0 * pc.KBlocks + kb];
+        const FLOAT2 m1 = Meta[row1 * pc.KBlocks + kb];
+        const FLOAT2 m2 = Meta[row2 * pc.KBlocks + kb];
+        const FLOAT2 m3 = Meta[row3 * pc.KBlocks + kb];
+
+        const uint shift = startBitInWord + kIn4 * 2u;
+        const float q0 = float((w0 >> shift) & 3u) - 2.0;
+        const float q1 = float((w1 >> shift) & 3u) - 2.0;
+        const float q2 = float((w2 >> shift) & 3u) - 2.0;
+        const float q3 = float((w3 >> shift) & 3u) - 2.0;
+
+        const uint outIdx = (((k4 * nBlock32Count + nBlock32) * 4u + kIn4) * 8u + nVecIn32);
+        DstB4[outIdx] = FLOAT4(
+            FLOAT(q0) * m0.x + m0.y,
+            FLOAT(q1) * m1.x + m1.y,
+            FLOAT(q2) * m2.x + m2.y,
+            FLOAT(q3) * m3.x + m3.y);
+    }
+}
diff --git a/source/backend/vulkan/buffer/execution/glsl/int3_weight_to_pack.comp b/source/backend/vulkan/buffer/execution/glsl/int3_weight_to_pack.comp
--- /dev/null
+++ b/source/backend/vulkan/buffer/execution/glsl/int3_weight_to_pack.comp
@@ -0,0 +1,58 @@
+// Dequantize int3 [padN, padK/16, 2] uint pairs into FLOAT4 B [K/4, N/32, 4, 8].
+// Pair[0] = low 2 bits, pair[1] = high 1 bit (low 16 bits used). signed = unsigned - 4.
+layout(local_size_x = 16, local_size_y = 8, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer WeightBuffer { uint Src[]; };
+layout(binding = 1) readonly buffer MetaBuffer { FLOAT2 Meta[]; };
+layout(binding = 2) writeonly buffer DstBuffer { FLOAT4 DstB4[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint N; uint K; uint blockSize; uint KBlocks;
+} pc;
+
+void main() {
+    const uint nVec = gl_GlobalInvocationID.x;
+    const uint k4 = gl_GlobalInvocationID.y;
+    const uint nVec4Count = pc.N >> 2u;
+    const uint K4 = pc.K >> 2u;
+    const uint nBlock32Count = pc.N >> 5u;
+    if (nVec >= nVec4Count || k4 >= K4) return;
+
+    const uint nBlock32 = nVec >> 3u;
+    const uint nVecIn32 = nVec & 7u;
+    const uint nBase = nVec << 2u;
+    const uint gkBase = k4 << 2u;
+
+    const uint pairsPerRow = (pc.K + 15u) >> 4u; // padK/16
+    const uint pairOffset = gkBase >> 4u;        // / 16
+    const uint kInPair = gkBase & 15u;           // 0,4,8,12 (since gkBase % 4 == 0)
+    const uint shift2 = kInPair * 2u;            // bit shift in low2 word
+    const uint shift1 = kInPair;                 // bit shift in hi1 word
+
+    uint lows[4];
+    uint his[4];
+    for (uint r = 0u; r < 4u; ++r) {
+        const uint base = ((nBase + r) * pairsPerRow + pairOffset) * 2u;
+        lows[r] = Src[base + 0u];
+        his[r] = Src[base + 1u];
+    }
+
+    for (uint kIn4 = 0u; kIn4 < 4u; ++kIn4) {
+        const uint gk = gkBase + kIn4;
+        const uint kb = gk / max(pc.blockSize, 1u);
+
+        FLOAT2 m[4];
+        for (uint r = 0u; r < 4u; ++r) {
+            m[r] = Meta[(nBase + r) * pc.KBlocks + kb];
+        }
+
+        const uint outIdx = (((k4 * nBlock32Count + nBlock32) * 4u + kIn4) * 8u + nVecIn32);
+        FLOAT4 row;
+        for (uint r = 0u; r < 4u; ++r) {
+            uint q = ((lows[r] >> (shift2 + kIn4 * 2u)) & 3u) |
+                     (((his[r] >> (shift1 + kIn4)) & 1u) << 2);
+            row[r] = FLOAT(float(q) - 4.0) * m[r].x + m[r].y;
+        }
+        DstB4[outIdx] = row;
+    }
+}
