diff --git a/source/backend/vulkan/buffer/execution/glsl/attention_prefill_kblock_softmax_online_subgroup.comp b/source/backend/vulkan/buffer/execution/glsl/attention_prefill_kblock_softmax_online_subgroup.comp
--- /dev/null
+++ b/source/backend/vulkan/buffer/execution/glsl/attention_prefill_kblock_softmax_online_subgroup.comp
@@ -0,0 +1,94 @@
+#extension GL_KHR_shader_subgroup_arithmetic : require
+
+layout(set=0, binding=0) buffer s0 {
+    FLOAT4 data[];
+} uW;
+
+layout(set=0, binding=1) readonly buffer s1 {
+    FLOAT4 data[];
+} uQK;
+
+layout(set=0, binding=2) buffer s2 {
+    float data[];
+} uM;
+
+layout(set=0, binding=3) buffer s3 {
+    float data[];
+} uL;
+
+layout(set=0, binding=4) buffer s4 {
+    float data[];
+} uAlpha;
+
+layout(set=0, binding=5) readonly uniform constBuffer {
+    ivec4 s0; // qLen, kLen, headNum, kvHeadNum
+    ivec4 s1; // headDim, group, pastLen, totalLen
+    ivec4 s2; // maskQlen, maskKvlen, hasMask, cacheMaxLen
+    vec4 f0;  // scale, 0, 0, 0
+} uConst;
+
+layout(push_constant) uniform PushConsts {
+    uint blockLen;
+} pc;
+
+// One workgroup == one subgroup computes one (q, head) row. Lanes reduce over the k4 columns with
+// subgroup arithmetic ops (subgroupMax / subgroupAdd), removing the shared-memory tree reduction and
+// all its barriers. Host sets local_size_x == device subgroup size, so the whole workgroup is a single
+// subgroup and the subgroup reduction spans the full row.
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+void main() {
+    const int h = int(gl_WorkGroupID.x);
+    const int q = int(gl_WorkGroupID.y);
+    const uint tid = gl_LocalInvocationID.x;
+    const uint groupSize = gl_WorkGroupSize.x;
+
+    const int qLen = uConst.s0.x;
+    const int headNum = uConst.s0.z;
+    // Dispatch grid is exactly (headNum, qLen, 1), so h and q are always in range and this guard is
+    // subgroup-uniform (never splits a subgroup before the reduction ops below).
+    if (h >= headNum || q >= qLen) {
+        return;
+    }
+
+    const int blockLen = int(pc.blockLen);
+    if (blockLen <= 0) {
+        return;
+    }
+    const int blockLen4 = ((blockLen + 3) / 4) * 4;
+    const int blockLen4_4 = blockLen4 / 4;
+
+    const int row = q * headNum + h;
+    const int base4 = row * blockLen4_4;
+
+    const float mOld = uM.data[row];
+    const float lOld = uL.data[row];
+
+    // block max via subgroup reduction (no shared memory, no barriers)
+    float mBlock = -3.402823466e38;
+    for (int k4 = int(tid); k4 < blockLen4_4; k4 += int(groupSize)) {
+        vec4 v = vec4(uQK.data[base4 + k4]);
+        mBlock = max(mBlock, max(max(v.x, v.y), max(v.z, v.w)));
+    }
+    mBlock = subgroupMax(mBlock);
+
+    const float mNew = max(mOld, mBlock);
+    const float alpha = (lOld > 0.0) ? exp(mOld - mNew) : 0.0;
+
+    // block sum of exp(score - mNew) and write unnormalized weights
+    float sumW = 0.0;
+    for (int k4 = int(tid); k4 < blockLen4_4; k4 += int(groupSize)) {
+        vec4 v = vec4(uQK.data[base4 + k4]);
+        vec4 w = exp(v - vec4(mNew));
+        sumW += w.x + w.y + w.z + w.w;
+        uW.data[base4 + k4] = FLOAT4(w);
+    }
+    sumW = subgroupAdd(sumW);
+    const float lNew = lOld * alpha + sumW;
+
+    if (tid == 0u) {
+        uM.data[row] = mNew;
+        uL.data[row] = lNew;
+        uAlpha.data[row] = alpha;
+    }
+}
