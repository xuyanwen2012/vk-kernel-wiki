+                    vec4 k0 = unpackSnorm4x8(uKernel.data[(kPosOffset+fz) * 4 + 0]);
+                    vec4 k1 = unpackSnorm4x8(uKernel.data[(kPosOffset+fz) * 4 + 1]);
+                    vec4 k2 = unpackSnorm4x8(uKernel.data[(kPosOffset+fz) * 4 + 2]);
+                    vec4 k3 = unpackSnorm4x8(uKernel.data[(kPosOffset+fz) * 4 + 3]);
+                    k0 = k0 * ws + wb;
+                    k1 = k1 * ws + wb;
+                    k2 = k2 * ws + wb;
+                    k3 = k3 * ws + wb;
+                    color  += k0*inputValue.x;
+                    color  += k1*inputValue.y;
+                    color  += k2*inputValue.z;
+                    color  += k3*inputValue.w;
+                }
+            }
+        }
+
+#ifdef RELU
+        color = max(color, vec4(0));
+#endif
+#ifdef RELU6
+        color = clamp(color, vec4(0), vec4(6));
+#endif
+        int oPos = pos.x
+            + pos.y * uConstant.outputSize.x
+            + pos.z * uConstant.outputSize.x * uConstant.outputSize.y
+            ;
+        uOutput.data[oPos] = color;
+    }
+}
