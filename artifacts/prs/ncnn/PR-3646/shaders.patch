+        afp v2 = image3d_ld1(bottom_blob, ivec3(sx4.b, sy4.b, z));
+        afp v3 = image3d_ld1(bottom_blob, ivec3(sx4.a, sy4.a, z));
+
+        afpvec4 k = image3d_ld4(weight_blob, ivec3(0, z, gz));
+
+        sum0 += v0 * k;
+        sum1 += v1 * k;
+        sum2 += v2 * k;
+        sum3 += v3 * k;
