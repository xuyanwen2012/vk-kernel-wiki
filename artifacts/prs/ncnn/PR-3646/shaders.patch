+            }
+        }
+
+        if (lx == 0)
+        {
+            for (int z4 = 0; z4 < LOCAL_MEMORY_UNROLL_INCH; z4++)
+            {
+                tmp_k[lz][z4] = sfp2lfpvec4(weight_data[w_offset + z4]);
+            }
+        }
+
