+        afp v1 = buffer_ld1(bottom_blob_data, v_offset + 1);
+        afp v2 = buffer_ld1(bottom_blob_data, v_offset + 2);
+        afp v3 = buffer_ld1(bottom_blob_data, v_offset + 3);
