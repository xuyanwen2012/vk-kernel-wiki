+    const uint K_Nd4p_USGN_USGK = K_Nd4p_USGN * UNROLL_SG_K;
+    const uint K_Nd4p_USGN_USGK_d_subgroupsize = (K_Nd4p_USGN_USGK + (subgroup_size * UNROLL_WG_M - 1)) / (subgroup_size * UNROLL_WG_M);
