+
+                    if (broadcast_type_C == 0)
+                    {
+                        sumfp += vec4(float(buffer_ld1(C_blob_data, 0)) * beta);
+                    }
+                    if (broadcast_type_C == 1 || broadcast_type_C == 2)
+                    {
+                        sumfp.r += float(buffer_ld1(C_blob_data, gm4.r)) * beta;
