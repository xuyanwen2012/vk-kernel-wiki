+            y = (p.h - 1) - abs(y - (p.h - 1));
+            z = (p.c * 4 - 1) - abs(z - (p.c * 4 - 1));
+
+            int v_offset = (z / 4) * psc(cstep) + y * psc(w) + x;
+            ivec4 v = i8buffer_ld4(bottom_blob_data, v_offset);
+            i8buffer_st1(top_blob_data, gi, v[z % 4]);
+        }
+    }
+}
