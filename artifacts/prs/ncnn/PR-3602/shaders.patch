+    image3d_st8(top_blob, ivec3(x, y + 1, gz), v10);
+    image3d_st8(top_blob, ivec3(x + 1, y + 1, gz), v11);
+    image3d_st8(top_blob, ivec3(x + 2, y + 1, gz), v12);
+    image3d_st8(top_blob, ivec3(x + 3, y + 1, gz), v13);
