+        afpvec8 v1 = buffer_ld8(bottom_blob_data, v_offset + 1);
+        afpvec8 v2 = buffer_ld8(bottom_blob_data, v_offset + 2);
+        afpvec8 v3 = buffer_ld8(bottom_blob_data, v_offset + 3);
+
