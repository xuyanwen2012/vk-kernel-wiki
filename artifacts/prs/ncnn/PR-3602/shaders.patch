+    image3d_st1(top_blob, ivec3(gx, gy, gz), sum);
+#else
+    const int gi = gz * psc(outcstep) + gy * psc(outw) + gx;
+
+    buffer_st1(top_blob_data, gi, sum);
+#endif
+}
