+        sum3.g += dot(v3[0], k1[0]) + dot(v3[1], k1[1]);
+        sum3.b += dot(v3[0], k2[0]) + dot(v3[1], k2[1]);
+        sum3.a += dot(v3[0], k3[0]) + dot(v3[1], k3[1]);
