+    if (gx >= p.outw || gy >= p.outh || gz >= p.outc)
+        return;
+
+    vec4 sum;
+
+    if (bias_term == 1)
+    {
+        sum = bias_data[gx];
+    }
+    else
+    {
+        sum = vec4(0.0);
+    }
+
+    const int size = p.w * p.h;
+
+    int w_offset = gx * size * p.c;
+
+    for (int z = 0; z < p.c; z++)
