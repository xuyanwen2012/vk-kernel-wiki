+layout (binding = 2) readonly buffer b_blob { vec4 b_blob_data[]; };
+layout (binding = 1) writeonly buffer top_blob { vec4 top_blob_data[]; };
+
+layout (push_constant) uniform parameter
+{
+    int adims;
+    int aw;
+    int ah;
+    int ac;
+    int acstep;
+
+    int bdims;
+    int bw;
+    int bh;
+    int bc;
+    int bcstep;
+
+    int outdims;
+    int outw;
+    int outh;
+    int outc;
+    int outcstep;
+} p;
+
+void main()
+{
+    int gx = int(gl_GlobalInvocationID.x);
+    int gy = int(gl_GlobalInvocationID.y);
+    int gz = int(gl_GlobalInvocationID.z);
+
+    if (gx >= p.outw || gy >= p.outh || gz >= p.outc)
+        return;
+
+    const int gi = gz * p.outcstep + gy * p.outw + gx;
+
+    vec4 v1 = a_blob_data[gi];
+
+    vec4 res;
+
+    if (with_scalar == 1)
+    {
+        if (op_type == 0) res = v1 + b;
+        if (op_type == 1) res = v1 - b;
+        if (op_type == 2) res = v1 * b;
+        if (op_type == 3) res = v1 / b;
+        if (op_type == 4) res = max(v1, b);
+        if (op_type == 5) res = min(v1, b);
+        if (op_type == 6) res = pow(v1, vec4(b));
+        if (op_type == 7) res = b - v1;
+        if (op_type == 8) res = b / v1;
+
+        a_blob_data[gi] = res;
+
+        return;
+    }
+
+    if (p.adims == p.bdims)
+    {
+        vec4 v2 = b_blob_data[gi];
+
+        if (op_type == 0) res = v1 + v2;
+        if (op_type == 1) res = v1 - v2;
+        if (op_type == 2) res = v1 * v2;
+        if (op_type == 3) res = v1 / v2;
+        if (op_type == 4) res = max(v1, v2);
+        if (op_type == 5) res = min(v1, v2);
+        if (op_type == 6) res = pow(v1, v2);
+        if (op_type == 7) res = v2 - v1;
+        if (op_type == 8) res = v2 / v1;
+
+        top_blob_data[gi] = res;
+
+        return;
+    }
+
+    // TODO broadcast
+}
