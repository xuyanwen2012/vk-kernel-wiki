+
+    if (gx >= p.outw || gy >= p.outh || gz >= p.outc)
+        return;
+
+    vec4 res;
+
+    if (pooling_type == 0)
+    {
+        res = vec4(-99999999);
+
+        int v_offset = gz * p.cstep + gy * stride_h * p.w + gx * stride_w;
+
+        for (int y = 0; y < kernel_h; y++)
+        {
+            for (int x = 0; x < kernel_w; x++)
+            {
