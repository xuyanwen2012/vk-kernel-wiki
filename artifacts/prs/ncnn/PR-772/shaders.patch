+
+        for (int y = 0; y < kernel_h; y++)
+        {
+            for (int x = 0; x < kernel_w; x++)
+            {
+                res += bottom_blob_data[v_offset + x];
+            }
+
+            v_offset += p.w;
+        }
+
+        res /= kernel_w * kernel_h;
