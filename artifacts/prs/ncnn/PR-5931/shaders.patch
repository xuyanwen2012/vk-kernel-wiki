+#if NCNN_image_shader
+        image3d_st8(sum_workspace_3d, ivec3(gx, gy, gz), sum_value);
+#else
+        buffer_st8(sum_workspace_data, gz * psc(outcstep) + gy * psc(h) + gx, sum_value);
 #endif
         return;
     }
